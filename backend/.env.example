# Porta HTTP da API
PORT=3333

# development | test | production
NODE_ENV=development

# Caminho do arquivo SQLite
DATABASE_FILE=./data/trocaplantao.sqlite

# Segredo de assinatura do access token (HS256).
# Gere o seu com:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-este-valor-por-um-segredo-aleatorio-de-48-bytes
JWT_ISSUER=trocaplantao-api
JWT_AUDIENCE=trocaplantao-app

# Validade do access token (segundos) - curta de proposito
ACCESS_TOKEN_TTL=900

# Validade do refresh token (segundos) - 30 dias
REFRESH_TOKEN_TTL=2592000

# Origens liberadas no CORS, separadas por virgula (Expo Web)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Tentativas de login por janela e tamanho da janela (segundos)
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW=300
